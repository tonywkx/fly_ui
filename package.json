{
  "name": "fly-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "bake": "pnpm --filter pipeline bake",
    "scout": "pnpm --filter pipeline scout",
    "pull": "pnpm --filter pipeline pull",
    "cloud": "pnpm --filter pipeline cloud",
    "neuropil": "pnpm --filter pipeline neuropil",
    "graph": "pnpm --filter pipeline graph",
    "snap": "tsx scripts/snap.ts",
    "perf": "tsx scripts/perf.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts",
    "lint": "biome check .",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
